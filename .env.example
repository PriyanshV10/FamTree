# ============================================================================
# FamTree — Environment Configuration Example
# ============================================================================
# Duplicate this file as .env.local to configure cloud Supabase persistence.
#
# If these environment variables are omitted or retain placeholder values,
# FamTree automatically operates using its built-in local persistence layer,
# persisting all trees, people, and relationships in browser storage across
# page reloads, browser restarts, and test runs.
# ============================================================================

# Supabase Project URL (from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Publishable Key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# CRITICAL SECURITY RULE:
# NEVER put your Supabase service_role key into any NEXT_PUBLIC_ variable!
# The service_role key bypasses Row Level Security and must remain server-side only.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
